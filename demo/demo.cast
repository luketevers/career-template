[22.505821, "o", "\r\n\u001b[2m# 5. Try to make it lie. (You can't — unknown claims fail the build.)\u001b[0m\r\n"]
[24.51345, "o", "\u001b[1m$ python3 - <<'EOF'\r\nimport yaml, pathlib\r\nr = yaml.safe_load(open('examples/sam-rivera/resume.yaml'))\r\nr['experience'][0]['include'].append('corvid-kubernetes-at-scale')  # invented\r\npathlib.Path('/var/folders/pk/c_260r6n23d41183qgb_7tvh0000gn/T/tmp.E9Bsb1Bs27/lying-resume.yaml').write_text(yaml.safe_dump(r))\r\nEOF\r\npython3 engine/build_resume.py --profile examples/sam-rivera/profile.yaml --resume /var/folders/pk/c_260r6n23d41183qgb_7tvh0000gn/T/tmp.E9Bsb1Bs27/lying-resume.yaml --layout engine/layouts/classic --out /var/folders/pk/c_260r6n23d41183qgb_7tvh0000gn/T/tmp.E9Bsb1Bs27/nope.html\u001b[0m\r\n"]
