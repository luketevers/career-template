[0.023524, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.024683, "o", "\u001b[1mcareer-template\u001b[0m — the resume that compounds\r\n\r\n\u001b[2m# Meet Sam Rivera. Fictional engineer, real pipeline.\u001b[0m\r\n"]
[2.032101, "o", "\u001b[1m$ grep -A3 'identity:' examples/sam-rivera/profile.yaml | head -4\u001b[0m\r\n"]
[2.747349, "o", "identity:\r\n  name: Sam Rivera\r\n  email: sam.rivera@example.com\r\n  location: Chicago, IL\r\n"]
[4.15134, "o", "\r\n\u001b[2m# 1. Point it at a live job board (Linear's, via the Ashby API):\u001b[0m\r\n"]
[6.15633, "o", "\u001b[1m$ curl -s 'https://jobs.ashbyhq.com/api/non-user-graphql' -H 'Content-Type: application/json' --data '{\"operationName\":\"ApiJobBoardWithTeams\",\"variables\":{\"organizationHostedJobsPageName\":\"linear\"},\"query\":\"query ApiJobBoardWithTeams($organizationHostedJobsPageName: String!) { jobBoard: jobBoardWithTeams(organizationHostedJobsPageName: $organizationHostedJobsPageName) { jobPostings { title locationName } } }\"}' | python3 -c 'import json,sys; [print(\" •\", p[\"title\"], \"—\", p.get(\"locationName\",\"\")) for p in json.load(sys.stdin)[\"data\"][\"jobBoard\"][\"jobPostings\"][:6]]' || echo ' (offline — see examples/sam-rivera/snapshots/)'\u001b[0m\r\n"]
[7.008418, "o", " • Account Executive, Startups — North America\r\n • Analytics Engineer — North America\r\n • Customer Success Manager, Enterprise — North America\r\n • Customer Success Manager, Growth — North America\r\n • Deal Desk — North America\r\n • Developer Relations — Europe\r\n"]
[9.022484, "o", "\r\n\u001b[2m# 2. The agent ranks fit against Sam's profile — strengths AND named gaps.\u001b[0m\r\n"]
[11.031179, "o", "\u001b[2m   (excerpt from the recorded pipeline run)\u001b[0m\r\n"]
[11.036611, "o", "   Senior/Staff Product Engineer, AI — ~75%\r\n   + LLM feature shipped behind a 500-case offline eval set\r\n   + internal tooling with 200+ daily users\r\n   – gap they'll probe: no model training (API-level work only)\r\n"]
[14.042978, "o", "\r\n\u001b[2m# 3. Tailor a variant. Every bullet is selected from Sam's verified profile:\u001b[0m\r\n"]
[16.053017, "o", "\u001b[1m$ python3 engine/build_resume.py --profile examples/sam-rivera/profile.yaml --resume examples/sam-rivera/resume.yaml --layout engine/layouts/classic --out /var/folders/pk/c_260r6n23d41183qgb_7tvh0000gn/T/tmp.E9Bsb1Bs27/resume.html --title Linear\u001b[0m\r\n"]
